#### Picard2 sample <sample>/picard_metrics.txt
cd <sample>
[[ "<unstranded>" = "True" ]] && STRAND='NONE' || STRAND='SECOND_READ_TRANSCRIPTION_STRAND'
picard CollectRnaSeqMetrics I=<sample>.MAPQ<MAPQ>.hisat2.bam O=picard_metrics.txt REF_FLAT=$REF_FLAT \
    STRAND_SPECIFICITY="SECOND_READ_TRANSCRIPTION_STRAND" RIBOSOMAL_INTERVALS=$RRNA_INTERVALS
cd ..

